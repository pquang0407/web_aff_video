# Môi trường và Khóa bí mật (Secrets)
.env
*.local
*.secret

# File dữ liệu nhạy cảm Cookie & Phiên đăng nhập
automation/4_social_poster/data/facebook_cookies.json
automation/4_social_poster/data/page_config.json
