# Môi trường và Khóa bí mật (Secrets)
.env
*.local
*.secret

# File dữ liệu nhạy cảm & cấu hình runtime của Social Poster (không để git reset ghi đè)
automation/4_social_poster/data/facebook_cookies.json
automation/4_social_poster/data/page_config.json
automation/4_social_poster/data/fb_app_config.json
automation/4_social_poster/data/threads_config.json
automation/4_social_poster/data/tiktok_config.json
automation/4_social_poster/data/scheduler_config.json
automation/4_social_poster/data/post_history.json
automation/1_telegram_collector/fb_cookies.txt
automation/1_telegram_collector/ytdlp_archive.txt
storage/rabbit_bear_fifo_queue.json

# File video dung lượng lớn (MP4, MKV, MOV, TS)
storage/_legacy_archive/*
storage/1_raw/*
storage/2_web_full/*.mp4
storage/3_social_teaser/*.mp4
storage/3_social_teaser/*.mp3
!storage/1_raw/.gitkeep
!storage/2_web_full/.gitkeep
!storage/3_social_teaser/.gitkeep

# Python cache & logs
__pycache__/
*.py[cod]
*$py.class
*.log
.pytest_cache/

# OS rác
.DS_Store
Thumbs.db
desktop.ini
