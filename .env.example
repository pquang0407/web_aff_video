# Cấu hình API Keys & Biến môi trường hệ thống
# Lấy Gemini API Key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Cấu hình Cloudflare R2 (Tùy chọn cho Module 3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=web-aff-videos
R2_PUBLIC_DOMAIN=https://media.ten-mien-cua-ban.com

# Cấu hình Telegram Bot & Scraper (cho Module 1)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_ID=
TELEGRAM_CHANNEL_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SOURCE_CHANNELS=@trend_videos_channel

# Đường dẫn Web Player công khai (Vercel / Cloudflare / Domain riêng)
WEB_BASE_URL=https://your-domain.vercel.app
